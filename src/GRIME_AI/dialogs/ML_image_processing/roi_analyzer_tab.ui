          <item row="7" column="0"><widget class="QLabel" name="label_glcm_correlation"><property name="text"><string>GLCM Correlation:</string></property></widget></item>
          <item row="7" column="1"><widget class="QLineEdit" name="lineEdit_glcm_correlation"><property name="readOnly"><bool>true</bool></property><property name="maxLength"><number>10</number></property></widget></item>
