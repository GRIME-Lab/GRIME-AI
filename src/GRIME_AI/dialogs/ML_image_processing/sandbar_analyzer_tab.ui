<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SandbarAnalyzerTab</class>
 <widget class="QWidget" name="SandbarAnalyzerTab">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>965</width><height>700</height></rect>
  </property>
  <property name="font">
   <font><family>Arial</family><pointsize>11</pointsize></font>
  </property>
  <layout class="QVBoxLayout" name="verticalLayoutTab">

   <!-- Row 1: Folder path + Browse -->
   <item>
    <layout class="QHBoxLayout" name="horizontalLayoutFolderPath">
     <item>
      <widget class="QLineEdit" name="lineEdit_sandbar_images_folder">
       <property name="placeholderText"><string>Enter folder path…</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="pushButton_browse_sandbar_images_folder">
       <property name="text"><string>Browse</string></property>
      </widget>
     </item>
    </layout>
   </item>

   <!-- Row 2: Left control panel + Right display panel -->
   <item stretches="1">
    <layout class="QHBoxLayout" name="horizontalLayoutMain">

     <!-- LEFT PANEL: controls, fixed width -->
     <item>
      <layout class="QVBoxLayout" name="verticalLayoutLeftPanel">

       <!-- Edge detection group -->
       <item>
        <widget class="QGroupBox" name="groupBox_edgeDetection">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
           <horstretch>0</horstretch><verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="title"><string>Edge Detection</string></property>
         <layout class="QVBoxLayout" name="verticalLayoutEdgeInner">
          <property name="spacing"><number>4</number></property>

          <item>
           <layout class="QHBoxLayout" name="horizontalLayoutOperator">
            <item><widget class="QLabel" name="label_operator"><property name="text"><string>Operator:</string></property></widget></item>
            <item><widget class="QComboBox" name="comboBox_operator">
             <item><property name="text"><string>Canny</string></property></item>
             <item><property name="text"><string>Sobel</string></property></item>
             <item><property name="text"><string>Laplacian</string></property></item>
             <item><property name="text"><string>Prewitt</string></property></item>
            </widget></item>
           </layout>
          </item>

          <item>
           <layout class="QHBoxLayout" name="horizontalLayoutCannyLow">
            <item><widget class="QLabel" name="label_cannyLow"><property name="text"><string>Canny low:</string></property></widget></item>
            <item><widget class="QSpinBox" name="spinBox_cannyLow"><property name="minimum"><number>0</number></property><property name="maximum"><number>255</number></property><property name="value"><number>25</number></property></widget></item>
           </layout>
          </item>

          <item>
           <layout class="QHBoxLayout" name="horizontalLayoutCannyHigh">
            <item><widget class="QLabel" name="label_cannyHigh"><property name="text"><string>Canny high:</string></property></widget></item>
            <item><widget class="QSpinBox" name="spinBox_cannyHigh"><property name="minimum"><number>0</number></property><property name="maximum"><number>255</number></property><property name="value"><number>150</number></property></widget></item>
           </layout>
          </item>

          <item>
           <layout class="QHBoxLayout" name="horizontalLayoutSobelKsize">
            <item><widget class="QLabel" name="label_sobelKsize"><property name="text"><string>Sobel ksize:</string></property></widget></item>
            <item><widget class="QSpinBox" name="spinBox_sobelKsize"><property name="minimum"><number>1</number></property><property name="maximum"><number>7</number></property><property name="singleStep"><number>2</number></property><property name="value"><number>3</number></property></widget></item>
           </layout>
          </item>

          <item>
           <layout class="QHBoxLayout" name="horizontalLayoutBlur">
            <item><widget class="QLabel" name="label_blurKsize"><property name="text"><string>Pre-blur:</string></property></widget></item>
            <item><widget class="QSpinBox" name="spinBox_blurKsize"><property name="minimum"><number>0</number></property><property name="maximum"><number>15</number></property><property name="singleStep"><number>2</number></property><property name="value"><number>5</number></property></widget></item>
           </layout>
          </item>

          <item>
           <layout class="QHBoxLayout" name="horizontalLayoutErode">
            <item><widget class="QLabel" name="label_erodePx"><property name="text"><string>Boundary inset:</string></property></widget></item>
            <item><widget class="QSpinBox" name="spinBox_erodePx"><property name="minimum"><number>0</number></property><property name="maximum"><number>25</number></property><property name="value"><number>3</number></property></widget></item>
           </layout>
          </item>

         </layout>
        </widget>
       </item>

       <!-- Left image view selector -->
       <item>
        <widget class="QGroupBox" name="groupBox_leftView">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
           <horstretch>0</horstretch><verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="title"><string>Left Panel</string></property>
         <layout class="QVBoxLayout" name="verticalLayoutLeftView">
          <property name="spacing"><number>2</number></property>
          <item><widget class="QRadioButton" name="radioButton_view_segmented"><property name="text"><string>Segmented region</string></property><property name="checked"><bool>true</bool></property><attribute name="buttonGroup"><string>buttonGroup_leftView</string></attribute></widget></item>
          <item><widget class="QRadioButton" name="radioButton_view_original"><property name="text"><string>Original image</string></property><attribute name="buttonGroup"><string>buttonGroup_leftView</string></attribute></widget></item>
          <item><widget class="QRadioButton" name="radioButton_view_overlay"><property name="text"><string>Mask overlay</string></property><attribute name="buttonGroup"><string>buttonGroup_leftView</string></attribute></widget></item>
         </layout>
        </widget>
       </item>

       <!-- Right image analysis selector -->
       <item>
        <widget class="QGroupBox" name="groupBox_rightView">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
           <horstretch>0</horstretch><verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="title"><string>Right Panel</string></property>
         <layout class="QVBoxLayout" name="verticalLayoutRightView">
          <property name="spacing"><number>2</number></property>
          <item><widget class="QRadioButton" name="radioButton_out_edges"><property name="text"><string>Edges</string></property><property name="checked"><bool>true</bool></property><attribute name="buttonGroup"><string>buttonGroup_rightView</string></attribute></widget></item>
          <item><widget class="QRadioButton" name="radioButton_out_edges_on_image"><property name="text"><string>Edges on image</string></property><attribute name="buttonGroup"><string>buttonGroup_rightView</string></attribute></widget></item>
          <item><widget class="QRadioButton" name="radioButton_out_poc_composite"><property name="text"><string>POC composite</string></property><attribute name="buttonGroup"><string>buttonGroup_rightView</string></attribute></widget></item>
         </layout>
        </widget>
       </item>

       <!-- Color sub-unit clustering (feeds the POC composite) -->
       <item>
        <widget class="QGroupBox" name="groupBox_clustering">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
           <horstretch>0</horstretch><verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="title"><string>Color Sub-Units</string></property>
         <layout class="QVBoxLayout" name="verticalLayoutClustering">
          <property name="spacing"><number>2</number></property>
          <item>
           <layout class="QHBoxLayout" name="horizontalLayoutClusterMethod">
            <item><widget class="QLabel" name="label_clusterMethod"><property name="text"><string>Method:</string></property></widget></item>
            <item><widget class="QComboBox" name="comboBox_clusterMethod">
             <item><property name="text"><string>K-Means</string></property></item>
             <item><property name="text"><string>GMM</string></property></item>
             <item><property name="text"><string>Mean-Shift</string></property></item>
            </widget></item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout" name="horizontalLayoutClusterCount">
            <item><widget class="QLabel" name="label_clusterCount"><property name="text"><string>Clusters:</string></property></widget></item>
            <item><widget class="QSpinBox" name="spinBox_clusterCount"><property name="minimum"><number>2</number></property><property name="maximum"><number>12</number></property><property name="value"><number>4</number></property></widget></item>
           </layout>
          </item>
          <item><widget class="QRadioButton" name="radioButton_outline_all"><property name="text"><string>Outline all clusters</string></property><property name="checked"><bool>true</bool></property><attribute name="buttonGroup"><string>buttonGroup_outline</string></attribute></widget></item>
          <item><widget class="QRadioButton" name="radioButton_outline_dominant"><property name="text"><string>Dominant only</string></property><attribute name="buttonGroup"><string>buttonGroup_outline</string></attribute></widget></item>
         </layout>
        </widget>
       </item>

       <item>
        <spacer name="verticalSpacerLeftPanel">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property>
        </spacer>
       </item>

      </layout>
     </item>

     <!-- RIGHT PANEL: images + stats + filmstrip + buttons -->
     <item stretches="1">
      <layout class="QVBoxLayout" name="verticalLayoutRightPanel">

       <!-- Images pane: left display | right edge output -->
       <item>
        <widget class="QSplitter" name="splitter_display">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizePolicy">
          <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
           <horstretch>0</horstretch><verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <widget class="QWidget" name="widget_images_pane">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
            <horstretch>0</horstretch><verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <layout class="QHBoxLayout" name="horizontalLayoutImages">
           <property name="spacing"><number>4</number></property>
           <item>
            <widget class="QLabel" name="label_image_left">
             <property name="text"><string></string></property>
             <property name="alignment"><set>Qt::AlignCenter</set></property>
             <property name="sizePolicy">
              <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
               <horstretch>0</horstretch><verstretch>0</verstretch>
              </sizepolicy>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="label_image_right">
             <property name="text"><string></string></property>
             <property name="alignment"><set>Qt::AlignCenter</set></property>
             <property name="sizePolicy">
              <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
               <horstretch>0</horstretch><verstretch>0</verstretch>
              </sizepolicy>
             </property>
            </widget>
           </item>
          </layout>
         </widget>

         <!-- Stats table docked under the right panel -->
         <widget class="QTableWidget" name="tableWidget_edgeStats">
          <property name="minimumSize"><size><width>0</width><height>90</height></size></property>
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
            <horstretch>0</horstretch><verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
         </widget>
        </widget>
       </item>

       <!-- Filmstrip -->
       <item>
        <widget class="QListWidget" name="listWidget_filmstrip">
         <property name="verticalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
         <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOn</enum></property>
         <property name="iconSize"><size><width>100</width><height>100</height></size></property>
         <property name="movement"><enum>QListView::Static</enum></property>
         <property name="flow"><enum>QListView::LeftToRight</enum></property>
         <property name="resizeMode"><enum>QListView::Adjust</enum></property>
         <property name="spacing"><number>10</number></property>
         <property name="viewMode"><enum>QListView::IconMode</enum></property>
         <property name="wrapping" stdset="0"><bool>false</bool></property>
        </widget>
       </item>

       <!-- Buttons -->
       <item>
        <layout class="QHBoxLayout" name="horizontalLayoutSandbarButtons">
         <item><spacer name="leftSpacerSandbar"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property></spacer></item>
         <item>
          <widget class="QPushButton" name="pushButton_analyze">
           <property name="minimumSize"><size><width>150</width><height>40</height></size></property>
           <property name="styleSheet"><string notr="true">font: bold 11pt Arial;</string></property>
           <property name="text"><string>Analyze</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="pushButton_extract_sandbar_features">
           <property name="minimumSize"><size><width>170</width><height>40</height></size></property>
           <property name="styleSheet"><string notr="true">font: bold 11pt Arial;</string></property>
           <property name="text"><string>Extract Edge Features</string></property>
          </widget>
         </item>
         <item><spacer name="rightSpacerSandbar"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property></spacer></item>
        </layout>
       </item>

      </layout>
     </item>

    </layout>
   </item>

  </layout>
 </widget>
